# Copy to ai-agent/.env and fill in real values. Never commit ai-agent/.env.

# development | production
ENVIRONMENT=development

# Must match the backend API SECRET_KEY so access tokens can be validated
SECRET_KEY=

# Set to false only for isolated local experiments (leaves endpoints unauthenticated)
AI_AGENT_REQUIRE_AUTH=true

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

AI_AGENT_HOST=127.0.0.1
AI_AGENT_PORT=8001
