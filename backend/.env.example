# CareConnect Backend Environment Configuration Example
PROJECT_NAME="CareConnect Cloud API"
ENVIRONMENT=production
PORT=8000
HOST=0.0.0.0

# Database URL Examples:
# MySQL Cloud (Aiven / Railway / AWS RDS):
# DATABASE_URL=mysql+pymysql://avnadmin:your_password@mysql-careconnect.aivencloud.com:13402/defaultdb?ssl_mode=REQUIRED
#
# PostgreSQL Cloud (Render / Supabase):
# DATABASE_URL=postgresql+psycopg2://user:password@ep-sample-123.us-east-2.aws.neon.tech/neondb
#
# SQLite (Local Testing fallback):
DATABASE_URL=sqlite:///./careconnect.db

# Production JWT Secret Key (min 32 random characters):
SECRET_KEY=careconnect_super_secret_production_key_32chars_min_abcdef123456

# Allowed CORS Origins (comma-separated or * for mobile / all web origins):
CORS_ORIGINS=*
