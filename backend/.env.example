# Copy to backend/.env and fill in real values. Never commit backend/.env.
DATABASE_URL=sqlite:///./careconnect.db
PROJECT_NAME=CareConnect API

# development | production
ENVIRONMENT=development

# Required when ENVIRONMENT=production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Comma-separated list of browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Expose /docs and /openapi.json (defaults to true outside production)
ENABLE_DOCS=true
