DATABASE_URL=sqlite:///./careconnect.db
PROJECT_NAME=CareConnect API
SECRET_KEY=careconnect_super_secret_key_change_in_production
ENVIRONMENT=development
CORS_ORIGINS=*

# =============================================================================
# SMTP & Email Provider Configuration
# =============================================================================
# To send real emails via Gmail:
# 1. Enable 2-Step Verification in Google Account -> Security
# 2. Generate an "App Password" (16 characters)
# 3. Put your Gmail and the App Password below:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SENDER_EMAIL=emergency-alerts@careconnect.org
SMTP_FROM_NAME="CareConnect Emergency Response Network"

# Alternative: SendGrid API Key / Resend API Key
SENDGRID_API_KEY=
RESEND_API_KEY=
